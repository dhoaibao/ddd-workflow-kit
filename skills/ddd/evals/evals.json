      "id": "normal-flow",
      "category": "normal flow",
      "title": "Route one stage at a time",
      "prompt": "Route a broad bounded domain request through the focused stages without performing stage work in the orchestrator.",
      "input": {
        "entry_status": "complete",
        "request": {
          "version": "ddd-routing-v1",
          "stage": "ddd-discover",
          "objective": "assess approval domain",
          "scope": "approval slice",
          "artifacts": [],
          "evidence": ["requester outcome"],
          "claims": ["desired-policy: traceable approval"],
          "provenance": ["requester statement"],
          "assumptions": [],
          "open_questions": ["who validates policy"],
          "allowed_paths": ["docs/ddd/"],
          "return_to": "ddd"
        },
        "route_sequence": ["ddd-discover", "ddd-strategic", "ddd-tactical", "ddd-adoption", "ddd-review"],
        "expected_one_at_a_time": true
      },
      "expected_outcomes": ["Start broad routing at ddd-discover", "Emit one stage request at a time in canonical order", "Preserve evidence and state without emulating focused behavior"],
      "forbidden_outcomes": ["Perform discovery or modeling in ddd", "Skip directly to deployment approval", "Emit competing stage requests"]
    },
