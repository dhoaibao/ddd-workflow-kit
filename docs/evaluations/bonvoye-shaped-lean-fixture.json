  "cases": [
    {
      "id": "entitled-in-range-online-start",
      "input": {
        "entitled": true,
        "readiness": "ready",
        "channel": "online",
        "proximity": "in-range",
        "state": "not-started"
      },
      "expected_output": {
        "decision": "start",
        "state": "started"
      }
    },
    {
      "id": "entitlement-rejection",
      "input": {
        "entitled": false,
        "readiness": "ready",
        "channel": "online",
        "proximity": "in-range",
        "state": "not-started"
      },
      "expected_output": {
        "decision": "reject",
        "reason": "entitlement"
      }
    },
    {
      "id": "readiness-rejection",
      "input": {
        "entitled": true,
        "readiness": "not-ready",
        "channel": "online",
        "proximity": "in-range",
        "state": "not-started"
      },
      "expected_output": {
        "decision": "reject",
        "reason": "readiness"
      }
    },
    {
      "id": "duplicate-start",
      "input": {
        "entitled": true,
        "readiness": "ready",
        "channel": "online",
        "proximity": "in-range",
        "state": "started"
      },
      "expected_output": {
        "decision": "reject",
        "reason": "duplicate-start"
      }
    },
    {
      "id": "explicit-completion",
      "input": {
        "entitled": true,
        "readiness": "ready",
        "channel": "online",
        "proximity": "in-range",
        "state": "started",
        "completion": "explicit"
      },
      "expected_output": {
        "decision": "complete",
        "state": "completed"
      }
    },
    {
      "id": "duplicate-completion",
      "input": {
        "entitled": true,
        "readiness": "ready",
        "channel": "online",
        "proximity": "in-range",
        "state": "completed",
        "completion": "explicit"
      },
      "expected_output": {
        "decision": "reject",
        "reason": "duplicate-completion"
      }
    },
    {
      "id": "executable-proximity-profiles",
      "profiles": [
        "in-range-online",
        "out-of-range-online"
      ],
      "input": {
        "entitled": true,
        "readiness": "ready",
        "channel": "online",
        "state": "not-started"
      },
      "expected_output": {
        "in-range-online": "start",
        "out-of-range-online": "reject-proximity"
      }
    }
  ],
